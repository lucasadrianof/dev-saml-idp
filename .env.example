# Use the public HTTPS URL when an HTTPS tunnel or reverse proxy fronts the IdP.
# Include /simplesaml/ and the trailing slash.
SIMPLESAMLPHP_IDP_BASE_URL=https://idp.example.test/simplesaml/

# Copy these exact values from your service provider.
SIMPLESAMLPHP_SP_ENTITY_ID=https://app.example.test/saml
SIMPLESAMLPHP_SP_ASSERTION_CONSUMER_SERVICE=https://app.example.test/saml/acs
